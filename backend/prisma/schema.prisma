generator client {
  // Classic JS client: generates plain .js into node_modules, so `require('@prisma/client')` just works.
  provider = "prisma-client-js"
}

// Prisma 7: the connection URL lives in prisma.config.ts, not here.
datasource db {
  provider = "postgresql"
}

enum UserRole {
  candidate
  recruiter
  admin

  @@map("user_role")
}

enum UserStatus {
  active
  suspended

  @@map("user_status")
}

enum AuthTokenType {
  email_verification
  password_reset

  @@map("auth_token_type")
}

enum CompanyStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED

  @@map("company_status")
}

enum CompanyMemberRole {
  OWNER
  ADMIN
  RECRUITER

  @@map("company_member_role")
}

enum CompanyMembershipStatus {
  ACTIVE
  INVITED
  REMOVED

  @@map("company_membership_status")
}

enum JobStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  PAUSED
  CLOSED
  REJECTED
  EXPIRED
  ARCHIVED

  @@map("job_status")
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  OFFERED
  HIRED
  REJECTED
  WITHDRAWN

  @@map("application_status")
}

model User {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String     @unique // zod already lowercases it; see README note about citext
  passwordHash    String?    @map("password_hash") // nullable: Google OAuth users later
  fullName        String     @map("full_name")
  role            UserRole   @default(candidate)
  status          UserStatus @default(active)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  authTokens                AuthToken[]
  refreshTokens             RefreshToken[]
  candidateProfile          CandidateProfile?
  recruiterProfile          RecruiterProfile?
  ownedCompanies            Company[]                  @relation("CompanyOwner")
  approvedCompanies         Company[]                  @relation("CompanyApprover")
  companyMemberships        CompanyMembership[]
  createdJobs               Job[]                      @relation("JobCreator")
  updatedJobs               Job[]                      @relation("JobUpdater")
  approvedJobs              Job[]                      @relation("JobApprover")
  candidateApplications     Application[]              @relation("CandidateApplications")
  reviewedApplications      Application[]              @relation("RecruiterReviewedApplications")
  applicationStatusChanges  ApplicationStatusHistory[] @relation("ApplicationStatusChangedBy")

  @@map("users")
}

// One-time tokens for email verification + password reset (store only the hash)
model AuthToken {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type], map: "idx_auth_tokens_user_type")
  @@map("auth_tokens")
}

// Refresh tokens with rotation + reuse detection (familyId groups one login session chain)
model RefreshToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedBy String?   @map("replaced_by") @db.Uuid
  userAgent  String?   @map("user_agent")
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_refresh_user")
  @@index([familyId], map: "idx_refresh_family")
  @@map("refresh_tokens")
}

model CandidateProfile {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  phone             String?
  dateOfBirth       DateTime? @map("date_of_birth") @db.Date
  gender            String?
  headline          String?
  bio               String?
  location          String?
  city              String?
  state             String?
  country           String?
  yearsOfExperience Decimal?  @map("years_of_experience") @db.Decimal(4, 1)
  currentJobTitle   String?   @map("current_job_title")
  currentCompany    String?   @map("current_company")
  skills            String[]  @default([])
  resumeKey         String?   @map("resume_key")
  resumeFileName    String?   @map("resume_file_name")
  resumeMimeType    String?   @map("resume_mime_type")
  resumeFileSize    Int?      @map("resume_file_size")
  resumeUpdatedAt   DateTime? @map("resume_updated_at") @db.Timestamptz(6)
  linkedinUrl       String?   @map("linkedin_url")
  githubUrl         String?   @map("github_url")
  portfolioUrl      String?   @map("portfolio_url")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([city], map: "idx_candidate_profiles_city")
  @@index([state], map: "idx_candidate_profiles_state")
  @@map("candidate_profiles")
}

model Company {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  logoUrl            String?       @map("logo_url")
  website            String?
  email              String?
  contactNumber      String?       @map("contact_number")
  industry           String?
  companySize        String?       @map("company_size")
  companyType        String?       @map("company_type")
  foundedYear        Int?          @map("founded_year")
  country            String?
  state              String?
  city               String?
  address            String?
  location           String?
  description        String?
  linkedinUrl        String?       @map("linkedin_url")
  gstin              String?
  registrationNumber String?       @map("registration_number")
  ownerId            String?       @map("owner_id") @db.Uuid
  status             CompanyStatus @default(DRAFT)
  rejectionReason    String?       @map("rejection_reason")
  suspensionReason   String?       @map("suspension_reason")
  submittedAt        DateTime?     @map("submitted_at") @db.Timestamptz(6)
  approvedAt         DateTime?     @map("approved_at") @db.Timestamptz(6)
  approvedById       String?       @map("approved_by") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner        User?               @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  approvedBy   User?               @relation("CompanyApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  recruiters   RecruiterProfile[]
  memberships  CompanyMembership[]
  jobs         Job[]
  applications Application[]

  @@index([ownerId], map: "idx_companies_owner_id")
  @@index([status], map: "idx_companies_status")
  @@index([name], map: "idx_companies_name")
  @@map("companies")
}

model CompanyMembership {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String                  @map("company_id") @db.Uuid
  userId           String                  @map("user_id") @db.Uuid
  role             CompanyMemberRole       @default(RECRUITER)
  membershipStatus CompanyMembershipStatus @default(ACTIVE) @map("membership_status")
  joinedAt         DateTime                @default(now()) @map("joined_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId], map: "uq_company_memberships_company_user")
  @@index([companyId], map: "idx_company_memberships_company_id")
  @@index([userId], map: "idx_company_memberships_user_id")
  @@map("company_memberships")
}

model RecruiterProfile {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  phone       String?
  designation String?
  companyId   String?  @map("company_id") @db.Uuid
  linkedinUrl String?  @map("linkedin_url")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId], map: "idx_recruiter_profiles_company_id")
  @@map("recruiter_profiles")
}

model Job {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                    String    @map("job_title")
  companyId                String    @map("company_id") @db.Uuid
  createdById              String    @map("created_by") @db.Uuid
  updatedById              String?   @map("updated_by") @db.Uuid
  approvedById             String?   @map("approved_by") @db.Uuid

  department               String?
  category                 String?   @map("job_category")
  description              String    @map("job_description")
  summary                  String?   @map("job_summary")
  numberOfOpenings         Int       @default(1) @map("number_of_openings")
  employmentType           String    @map("employment_type")
  workMode                 String    @map("work_mode")

  experienceLevel          String?   @map("experience_required")
  minExperience            Decimal?  @default(0) @map("min_experience") @db.Decimal(4, 1)
  maxExperience            Decimal?  @map("max_experience") @db.Decimal(4, 1)

  minSalary                Decimal?  @map("min_salary") @db.Decimal(12, 2)
  maxSalary                Decimal?  @map("max_salary") @db.Decimal(12, 2)
  salaryCurrency           String    @default("INR") @map("salary_currency")
  salaryPeriod             String    @default("Yearly") @map("salary_period")
  discloseSalary           Boolean   @default(true) @map("disclose_salary")

  country                  String?
  state                    String?
  city                     String?
  officeLocation           String?   @map("office_location")
  pincode                  String?
  location                 String?

  requiredSkills           String[]  @default([]) @map("required_skills")
  preferredSkills          String[]  @default([]) @map("preferred_skills")
  educationalQualification String?   @map("educational_qualification")
  minEducationLevel        String?   @map("min_education_level")
  preferredQualifications  String?   @map("preferred_qualifications")
  requiredCertifications   String[]  @default([]) @map("required_certifications")
  experienceDescription    String?   @map("experience_description")
  additionalRequirements   String?   @map("additional_requirements")

  responsibilities         String[]  @default([])
  benefits                 String[]  @default([])
  perks                    String[]  @default([])
  additionalInfo           String?   @map("additional_info")
  applicationInstructions  String?   @map("application_instructions")
  contactEmail             String?   @map("contact_email")

  applicationDeadline      DateTime? @map("application_deadline") @db.Timestamptz(6)
  allowAfterDeadline       Boolean   @default(false) @map("allow_after_deadline")
  requireResume            Boolean   @default(true) @map("require_resume")
  requireCoverLetter       Boolean   @default(false) @map("require_cover_letter")
  maxApplications          Int?      @map("max_applications")
  applicationQuestions     Json      @default("[]") @map("application_questions")

  status                   JobStatus @default(DRAFT)
  requireAdminApproval     Boolean   @default(false) @map("require_admin_approval")
  rejectionReason          String?   @map("rejection_reason")
  submittedAt              DateTime? @map("submitted_at") @db.Timestamptz(6)
  publishedAt              DateTime? @map("published_at") @db.Timestamptz(6)
  pausedAt                 DateTime? @map("paused_at") @db.Timestamptz(6)
  closedAt                 DateTime? @map("closed_at") @db.Timestamptz(6)
  archivedAt               DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy    User          @relation("JobCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    User?         @relation("JobUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  approvedBy   User?         @relation("JobApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  applications Application[]

  @@index([companyId], map: "idx_jobs_company_id")
  @@index([createdById], map: "idx_jobs_created_by")
  @@index([status], map: "idx_jobs_status")
  @@index([employmentType], map: "idx_jobs_employment_type")
  @@index([workMode], map: "idx_jobs_work_mode")
  @@index([publishedAt], map: "idx_jobs_published_at")
  @@map("jobs")
}

model Application {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId                 String            @map("job_id") @db.Uuid
  candidateId           String            @map("candidate_id") @db.Uuid
  companyId             String            @map("company_id") @db.Uuid
  reviewedById          String?           @map("reviewed_by") @db.Uuid

  resumeKey             String?           @map("resume_key")
  resumeFileName        String?           @map("resume_file_name")
  resumeMimeType        String?           @map("resume_mime_type")
  resumeFileSize        Int?              @map("resume_file_size")

  coverLetter           String?           @map("cover_letter")
  answers               Json              @default("[]")
  additionalInformation String?           @map("additional_information")

  candidateSkills       String[]          @default([]) @map("candidate_skills")
  candidateExperience   Decimal?          @map("candidate_experience") @db.Decimal(4, 1)
  candidateSnapshot     Json              @default("{}") @map("candidate_snapshot")
  jobSnapshot           Json              @default("{}") @map("job_snapshot")

  status                ApplicationStatus @default(SUBMITTED)
  appliedAt             DateTime          @default(now()) @map("applied_at") @db.Timestamptz(6)
  lastStatusUpdatedAt   DateTime          @default(now()) @map("last_status_updated_at") @db.Timestamptz(6)
  withdrawnAt           DateTime?         @map("withdrawn_at") @db.Timestamptz(6)
  withdrawalReason      String?           @map("withdrawal_reason")
  rejectionReason       String?           @map("rejection_reason")
  recruiterNotes        Json              @default("[]") @map("recruiter_notes")

  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  job           Job                        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate     User                       @relation("CandidateApplications", fields: [candidateId], references: [id], onDelete: Cascade)
  company       Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reviewedBy    User?                      @relation("RecruiterReviewedApplications", fields: [reviewedById], references: [id], onDelete: SetNull)
  statusHistory ApplicationStatusHistory[]

  @@unique([jobId, candidateId], map: "uq_applications_job_candidate")
  @@index([candidateId], map: "idx_applications_candidate_id")
  @@index([jobId], map: "idx_applications_job_id")
  @@index([companyId], map: "idx_applications_company_id")
  @@index([status], map: "idx_applications_status")
  @@index([appliedAt], map: "idx_applications_applied_at")
  @@map("applications")
}

model ApplicationStatusHistory {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId  String             @map("application_id") @db.Uuid
  previousStatus ApplicationStatus? @map("previous_status")
  newStatus      ApplicationStatus  @map("new_status")
  changedById    String?            @map("changed_by") @db.Uuid
  changedByRole  String             @map("changed_by_role")
  reason         String?
  notes          String?
  changedAt      DateTime           @default(now()) @map("changed_at") @db.Timestamptz(6)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy   User?       @relation("ApplicationStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([applicationId], map: "idx_app_status_history_application_id")
  @@index([changedAt], map: "idx_app_status_history_changed_at")
  @@map("application_status_history")
}
