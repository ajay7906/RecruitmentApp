  notes          String?
  changedAt      DateTime           @default(now()) @map("changed_at") @db.Timestamptz(6)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy   User?       @relation("ApplicationStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([applicationId], map: "idx_app_status_history_application_id")
  @@index([changedAt], map: "idx_app_status_history_changed_at")
  @@map("application_status_history")
}

model Interview {
  id                       String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId            String          @map("application_id") @db.Uuid
  jobId                    String          @map("job_id") @db.Uuid
  candidateId              String          @map("candidate_id") @db.Uuid
  companyId                String          @map("company_id") @db.Uuid

  title                    String          @map("interview_title")
  roundNumber              Int             @default(1) @map("round_number")
  interviewType            String          @map("interview_type")
  interviewMode            InterviewMode   @default(ONLINE) @map("interview_mode")

  interviewDate            DateTime        @map("interview_date") @db.Timestamptz(6)
  startTime                DateTime        @map("start_time") @db.Timestamptz(6)
  endTime                  DateTime        @map("end_time") @db.Timestamptz(6)
  timeZone                 String          @default("Asia/Kolkata") @map("time_zone")

  location                 String?
  meetingLink              String?         @map("meeting_link")
  description              String?
  instructions             String?
  allowCandidateReschedule Boolean         @default(true) @map("allow_candidate_reschedule")

  status                   InterviewStatus @default(SCHEDULED)
  candidateConfirmedAt     DateTime?       @map("candidate_confirmed_at") @db.Timestamptz(6)
  noShowParty              String?         @map("no_show_party")

  cancellationReason       String?         @map("cancellation_reason")
  cancellationType         String?         @map("cancellation_type")
  cancelledById            String?         @map("cancelled_by") @db.Uuid
  cancelledAt              DateTime?       @map("cancelled_at") @db.Timestamptz(6)

  createdById              String          @map("created_by") @db.Uuid
  updatedById              String?         @map("updated_by") @db.Uuid
  completedAt              DateTime?       @map("completed_at") @db.Timestamptz(6)
  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  application        Application                  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  job                Job                          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate          User                         @relation("CandidateInterviews", fields: [candidateId], references: [id], onDelete: Cascade)
  company            Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy          User                         @relation("InterviewCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy          User?                        @relation("InterviewUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  cancelledBy        User?                        @relation("InterviewCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)

  interviewers       InterviewerAssignment[]
  feedbacks          InterviewFeedback[]
  history            InterviewHistory[]
  rescheduleRequests InterviewRescheduleRequest[]

  @@index([applicationId, roundNumber], map: "idx_interviews_application_round")
  @@index([candidateId], map: "idx_interviews_candidate_id")
  @@index([companyId], map: "idx_interviews_company_id")
  @@index([jobId], map: "idx_interviews_job_id")
  @@index([status], map: "idx_interviews_status")
  @@index([startTime], map: "idx_interviews_start_time")
  @@map("interviews")
}

model InterviewerAssignment {
  id               String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  interviewId      String                      @map("interview_id") @db.Uuid
  interviewerId    String                      @map("interviewer_id") @db.Uuid
  interviewerRole  InterviewerRole             @default(TECHNICAL_INTERVIEWER) @map("interviewer_role")
  assignmentStatus InterviewerAssignmentStatus @default(ASSIGNED) @map("assignment_status")
  assignedById     String?                     @map("assigned_by") @db.Uuid
  assignedAt       DateTime                    @default(now()) @map("assigned_at") @db.Timestamptz(6)
  removedAt        DateTime?                   @map("removed_at") @db.Timestamptz(6)
  updatedAt        DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewer User      @relation("AssignedInterviewer", fields: [interviewerId], references: [id], onDelete: Cascade)
  assignedBy  User?     @relation("InterviewerAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([interviewId, interviewerId], map: "uq_interviewer_assignments_interview_user")
  @@index([interviewerId], map: "idx_interviewer_assignments_user")
  @@index([interviewId], map: "idx_interviewer_assignments_interview")
  @@map("interviewer_assignments")
}

model InterviewFeedback {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  interviewId           String                 @map("interview_id") @db.Uuid
  applicationId         String                 @map("application_id") @db.Uuid
  interviewerId         String                 @map("interviewer_id") @db.Uuid

  overallRating         Int                    @map("overall_rating")
  technicalRating       Int?                   @map("technical_rating")
  communicationRating   Int?                   @map("communication_rating")
  problemSolvingRating  Int?                   @map("problem_solving_rating")
  experienceRating      Int?                   @map("experience_rating")

  strengths             String?
  weaknesses            String?
  detailedFeedback      String                 @map("detailed_feedback")
  recommendation        FeedbackRecommendation
  isFinalSubmitted      Boolean                @default(true) @map("is_final_submitted")

  submittedAt           DateTime               @default(now()) @map("submitted_at") @db.Timestamptz(6)
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  interview   Interview   @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewer User        @relation("InterviewerFeedbacks", fields: [interviewerId], references: [id], onDelete: Cascade)

  @@unique([interviewId, interviewerId], map: "uq_interview_feedbacks_interview_interviewer")
  @@index([interviewId], map: "idx_interview_feedbacks_interview")
  @@index([applicationId], map: "idx_interview_feedbacks_application")
  @@index([interviewerId], map: "idx_interview_feedbacks_interviewer")
  @@map("interview_feedbacks")
}

model InterviewHistory {
