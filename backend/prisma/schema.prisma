generator client {
  // Classic JS client: generates plain .js into node_modules, so `require('@prisma/client')` just works.
  provider = "prisma-client-js"
}

// Prisma 7: the connection URL lives in prisma.config.ts, not here.
datasource db {
  provider = "postgresql"
}

enum UserRole {
  candidate
  recruiter
  admin

  @@map("user_role")
}

enum UserStatus {
  active
  suspended

  @@map("user_status")
}

enum AuthTokenType {
  email_verification
  password_reset

  @@map("auth_token_type")
}

enum CompanyStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED

  @@map("company_status")
}

enum CompanyMemberRole {
  OWNER
  ADMIN
  RECRUITER

  @@map("company_member_role")
}

enum CompanyMembershipStatus {
  ACTIVE
  INVITED
  REMOVED

  @@map("company_membership_status")
}

enum JobStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  PAUSED
  CLOSED
  REJECTED
  EXPIRED
  ARCHIVED
  UNDER_REVIEW

  @@map("job_status")
}

enum JobModerationStatus {
  NOT_REVIEWED
  FLAGGED
  UNDER_REVIEW
  ACTION_REQUIRED
  CLEARED

  @@map("job_moderation_status")
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  OFFERED
  HIRED
  REJECTED
  WITHDRAWN

  @@map("application_status")
}

enum ResumeProcessingStatus {
  NOT_PROCESSED
  PROCESSING
  TEXT_EXTRACTED
  FAILED
  UNSUPPORTED

  @@map("resume_processing_status")
}

enum InterviewStatus {
  DRAFT
  SCHEDULED
  RESCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW

  @@map("interview_status")
}

enum InterviewMode {
  ONLINE
  IN_PERSON
  TELEPHONIC

  @@map("interview_mode")
}

enum InterviewerRole {
  PRIMARY_INTERVIEWER
  TECHNICAL_INTERVIEWER
  HR_INTERVIEWER
  OBSERVER

  @@map("interviewer_role")
}

enum InterviewerAssignmentStatus {
  ASSIGNED
  ACCEPTED
  DECLINED
  COMPLETED
  REMOVED

  @@map("interviewer_assignment_status")
}

enum FeedbackRecommendation {
  STRONG_HIRE
  HIRE
  HOLD
  REJECT

  @@map("feedback_recommendation")
}

enum HiringDecisionType {
  SELECTED
  REJECTED
  ON_HOLD

  @@map("hiring_decision_type")
}

enum RescheduleRequestStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("reschedule_request_status")
}

model User {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String     @unique // zod already lowercases it; see README note about citext
  passwordHash    String?    @map("password_hash") // nullable: Google OAuth users later
  fullName        String     @map("full_name")
  role            UserRole   @default(candidate)
  status          UserStatus @default(active)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  authTokens                AuthToken[]
  refreshTokens             RefreshToken[]
  candidateProfile          CandidateProfile?
  recruiterProfile          RecruiterProfile?
  ownedCompanies            Company[]                     @relation("CompanyOwner")
  approvedCompanies         Company[]                     @relation("CompanyApprover")
  companyMemberships        CompanyMembership[]
  createdJobs               Job[]                         @relation("JobCreator")
  updatedJobs               Job[]                         @relation("JobUpdater")
  approvedJobs              Job[]                         @relation("JobApprover")
  moderatedJobs             Job[]                         @relation("JobModerator")
  jobModerationLogs         JobModerationLog[]            @relation("JobModerationActor")
  jobReports                JobReport[]                   @relation("JobReporter")
  candidateApplications     Application[]                 @relation("CandidateApplications")
  reviewedApplications      Application[]                 @relation("RecruiterReviewedApplications")
  applicationStatusChanges  ApplicationStatusHistory[]    @relation("ApplicationStatusChangedBy")

  candidateResumes          CandidateResume[]
  candidateSkills           CandidateSkill[]
  candidateEducations       CandidateEducation[]
  candidateExperiences      CandidateExperience[]
  candidateProjects         CandidateProject[]
  candidateCertifications   CandidateCertification[]
  candidateAchievements     CandidateAchievement[]
  candidateLanguages        CandidateLanguage[]

  candidateInterviews       Interview[]                   @relation("CandidateInterviews")
  createdInterviews         Interview[]                   @relation("InterviewCreator")
  updatedInterviews         Interview[]                   @relation("InterviewUpdater")
  cancelledInterviews       Interview[]                   @relation("InterviewCanceller")
  interviewerAssignments    InterviewerAssignment[]       @relation("AssignedInterviewer")
  assignedByInterviews      InterviewerAssignment[]       @relation("InterviewerAssignedBy")
  interviewFeedbacks        InterviewFeedback[]           @relation("InterviewerFeedbacks")
  interviewHistoryChanges   InterviewHistory[]            @relation("InterviewHistoryChangedBy")
  rescheduleRequests        InterviewRescheduleRequest[]  @relation("CandidateRescheduleRequests")
  reviewedRescheduleReqs    InterviewRescheduleRequest[]  @relation("RecruiterReviewedRescheduleRequests")
  candidateHiringDecisions  HiringDecision[]              @relation("CandidateHiringDecisions")
  madeHiringDecisions       HiringDecision[]              @relation("HiringDecisionMaker")

  @@map("users")
}

// One-time tokens for email verification + password reset (store only the hash)
model AuthToken {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type], map: "idx_auth_tokens_user_type")
  @@map("auth_tokens")
}

// Refresh tokens with rotation + reuse detection (familyId groups one login session chain)
model RefreshToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedBy String?   @map("replaced_by") @db.Uuid
  userAgent  String?   @map("user_agent")
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_refresh_user")
  @@index([familyId], map: "idx_refresh_family")
  @@map("refresh_tokens")
}

model CandidateProfile {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                  String    @unique @map("user_id") @db.Uuid
  profileImageUrl         String?   @map("profile_image_url")
  phone                   String?
  dateOfBirth             DateTime? @map("date_of_birth") @db.Date
  gender                  String?
  headline                String?
  bio                     String?
  careerSummary           String?   @map("career_summary")
  location                String?
  city                    String?
  state                   String?
  country                 String?
  pincode                 String?
  address                 String?
  yearsOfExperience       Decimal?  @map("years_of_experience") @db.Decimal(4, 1)
  relevantExperience      Decimal?  @map("relevant_experience") @db.Decimal(4, 1)
  currentJobTitle         String?   @map("current_job_title")
  currentCompany          String?   @map("current_company")
  employmentStatus        String?   @map("employment_status")
  expectedSalary          Decimal?  @map("expected_salary") @db.Decimal(12, 2)
  currentSalary           Decimal?  @map("current_salary") @db.Decimal(12, 2)
  salaryCurrency          String    @default("INR") @map("salary_currency")
  noticePeriod            String?   @map("notice_period")
  preferredLocations      String[]  @default([]) @map("preferred_locations")
  preferredEmploymentType String?   @map("preferred_employment_type")
  preferredWorkMode       String?   @map("preferred_work_mode")
  skills                  String[]  @default([])
  resumeKey               String?   @map("resume_key")
  resumeFileName          String?   @map("resume_file_name")
  resumeMimeType          String?   @map("resume_mime_type")
  resumeFileSize          Int?      @map("resume_file_size")
  resumeUpdatedAt         DateTime? @map("resume_updated_at") @db.Timestamptz(6)
  linkedinUrl             String?   @map("linkedin_url")
  githubUrl               String?   @map("github_url")
  portfolioUrl            String?   @map("portfolio_url")
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([city], map: "idx_candidate_profiles_city")
  @@index([state], map: "idx_candidate_profiles_state")
  @@map("candidate_profiles")
}

model CandidateResume {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String                 @map("candidate_id") @db.Uuid
  title                  String?                @map("resume_title")
  originalFileName       String                 @map("original_file_name")
  storedFileName         String                 @map("stored_file_name")
  storageKey             String                 @map("storage_key")
  fileType               String                 @map("file_type")
  mimeType               String                 @map("mime_type")
  fileSize               Int                    @map("file_size")
  version                Int                    @default(1)
  rootResumeId           String?                @map("root_resume_id") @db.Uuid
  previousVersionId      String?                @map("previous_version_id") @db.Uuid
  isLatestVersion        Boolean                @default(true) @map("is_latest_version")
  isPrimary              Boolean                @default(false) @map("is_primary")
  isDeleted              Boolean                @default(false) @map("is_deleted")
  resumeStatus           ResumeProcessingStatus @default(NOT_PROCESSED) @map("resume_status")
  extractedTextReference String?                @map("extracted_text_reference")
  extractedCharCount     Int?                   @map("extracted_char_count")
  uploadedAt             DateTime               @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  candidate       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  previousVersion CandidateResume?  @relation("ResumeVersionChain", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersions    CandidateResume[] @relation("ResumeVersionChain")
  applications    Application[]

  @@index([userId, isDeleted], map: "idx_candidate_resumes_user_deleted")
  @@index([userId, isPrimary], map: "idx_candidate_resumes_user_primary")
  @@index([rootResumeId], map: "idx_candidate_resumes_root_id")
  @@map("candidate_resumes")
}

model CandidateSkill {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("candidate_id") @db.Uuid
  name             String   @map("skill_name")
  normalizedName   String   @map("normalized_name")
  category         String   @default("Technical") @map("skill_category")
  experienceYears  Decimal? @map("experience_years") @db.Decimal(4, 1)
  proficiencyLevel String?  @map("proficiency_level")
  lastUsed         String?  @map("last_used")
  source           String   @default("MANUAL")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  candidate User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedName], map: "uq_candidate_skills_user_name")
  @@index([userId], map: "idx_candidate_skills_user")
  @@index([normalizedName], map: "idx_candidate_skills_normalized")
  @@map("candidate_skills")
}

model CandidateEducation {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("candidate_id") @db.Uuid
  degree            String
  fieldOfStudy      String    @map("field_of_study")
  institutionName   String    @map("institution_name")
  universityName    String?   @map("university_name")
  educationLevel    String    @map("education_level")
  startDate         DateTime  @map("start_date") @db.Date
  endDate           DateTime? @map("end_date") @db.Date
  currentlyStudying Boolean   @default(false) @map("currently_studying")
  grade             String?
  description       String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  candidate User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_candidate_education_user")
  @@map("candidate_education")
}

model CandidateExperience {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("candidate_id") @db.Uuid
  jobTitle         String    @map("job_title")
  companyName      String    @map("company_name")
  employmentType   String    @map("employment_type")
  workLocation     String?   @map("work_location")
  startDate        DateTime  @map("start_date") @db.Date
  endDate          DateTime? @map("end_date") @db.Date
  currentlyWorking Boolean   @default(false) @map("currently_working")
  description      String?
  responsibilities String[]  @default([])
  skillsUsed       String[]  @default([]) @map("skills_used")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  candidate User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_candidate_experience_user")
  @@map("candidate_experience")
}

model CandidateProject {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("candidate_id") @db.Uuid
  name             String    @map("project_name")
  description      String    @map("project_description")
  technologiesUsed String[]  @default([]) @map("technologies_used")
  projectUrl       String?   @map("project_url")
  githubUrl        String?   @map("github_url")
  startDate        DateTime? @map("start_date") @db.Date
  endDate          DateTime? @map("end_date") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  candidate User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_candidate_projects_user")
  @@map("candidate_projects")
}

model CandidateCertification {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @map("candidate_id") @db.Uuid
  name                String    @map("certification_name")
  issuingOrganization String    @map("issuing_organization")
  issueDate           DateTime  @map("issue_date") @db.Date
  expirationDate      DateTime? @map("expiration_date") @db.Date
  credentialId        String?   @map("credential_id")
  credentialUrl       String?   @map("credential_url")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  candidate User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_candidate_certifications_user")
  @@map("candidate_certifications")
}

model CandidateAchievement {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @map("candidate_id") @db.Uuid
  title               String    @map("achievement_title")
  description         String?
  date                DateTime? @db.Date
  issuingOrganization String?   @map("issuing_organization")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  candidate User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_candidate_achievements_user")
  @@map("candidate_achievements")
}

model CandidateLanguage {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("candidate_id") @db.Uuid
  name             String   @map("language_name")
  proficiencyLevel String   @map("proficiency_level")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  candidate User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name], map: "uq_candidate_languages_user_name")
  @@index([userId], map: "idx_candidate_languages_user")
  @@map("candidate_languages")
}

model Company {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  logoUrl            String?       @map("logo_url")
  website            String?
  email              String?
  contactNumber      String?       @map("contact_number")
  industry           String?
  companySize        String?       @map("company_size")
  companyType        String?       @map("company_type")
  foundedYear        Int?          @map("founded_year")
  country            String?
  state              String?
  city               String?
  address            String?
  location           String?
  description        String?
  linkedinUrl        String?       @map("linkedin_url")
  gstin              String?
  registrationNumber String?       @map("registration_number")
  ownerId            String?       @map("owner_id") @db.Uuid
  status             CompanyStatus @default(DRAFT)
  rejectionReason    String?       @map("rejection_reason")
  suspensionReason   String?       @map("suspension_reason")
  submittedAt        DateTime?     @map("submitted_at") @db.Timestamptz(6)
  approvedAt         DateTime?     @map("approved_at") @db.Timestamptz(6)
  approvedById       String?       @map("approved_by") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner           User?               @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  approvedBy      User?               @relation("CompanyApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  recruiters      RecruiterProfile[]
  memberships     CompanyMembership[]
  jobs            Job[]
  applications    Application[]
  interviews      Interview[]
  hiringDecisions HiringDecision[]

  @@index([ownerId], map: "idx_companies_owner_id")
  @@index([status], map: "idx_companies_status")
  @@index([name], map: "idx_companies_name")
  @@map("companies")
}

model CompanyMembership {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String                  @map("company_id") @db.Uuid
  userId           String                  @map("user_id") @db.Uuid
  role             CompanyMemberRole       @default(RECRUITER)
  membershipStatus CompanyMembershipStatus @default(ACTIVE) @map("membership_status")
  joinedAt         DateTime                @default(now()) @map("joined_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId], map: "uq_company_memberships_company_user")
  @@index([companyId], map: "idx_company_memberships_company_id")
  @@index([userId], map: "idx_company_memberships_user_id")
  @@map("company_memberships")
}

model RecruiterProfile {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  phone       String?
  designation String?
  companyId   String?  @map("company_id") @db.Uuid
  linkedinUrl String?  @map("linkedin_url")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId], map: "idx_recruiter_profiles_company_id")
  @@map("recruiter_profiles")
}

model Job {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                    String    @map("job_title")
  companyId                String    @map("company_id") @db.Uuid
  createdById              String    @map("created_by") @db.Uuid
  updatedById              String?   @map("updated_by") @db.Uuid
  approvedById             String?   @map("approved_by") @db.Uuid

  department               String?
  category                 String?   @map("job_category")
  description              String    @map("job_description")
  summary                  String?   @map("job_summary")
  numberOfOpenings         Int       @default(1) @map("number_of_openings")
  employmentType           String    @map("employment_type")
  workMode                 String    @map("work_mode")

  experienceLevel          String?   @map("experience_required")
  minExperience            Decimal?  @default(0) @map("min_experience") @db.Decimal(4, 1)
  maxExperience            Decimal?  @map("max_experience") @db.Decimal(4, 1)

  minSalary                Decimal?  @map("min_salary") @db.Decimal(12, 2)
  maxSalary                Decimal?  @map("max_salary") @db.Decimal(12, 2)
  salaryCurrency           String    @default("INR") @map("salary_currency")
  salaryPeriod             String    @default("Yearly") @map("salary_period")
  discloseSalary           Boolean   @default(true) @map("disclose_salary")

  country                  String?
  state                    String?
  city                     String?
  officeLocation           String?   @map("office_location")
  pincode                  String?
  location                 String?

  requiredSkills           String[]  @default([]) @map("required_skills")
  preferredSkills          String[]  @default([]) @map("preferred_skills")
  educationalQualification String?   @map("educational_qualification")
  minEducationLevel        String?   @map("min_education_level")
  preferredQualifications  String?   @map("preferred_qualifications")
  requiredCertifications   String[]  @default([]) @map("required_certifications")
  experienceDescription    String?   @map("experience_description")
  additionalRequirements   String?   @map("additional_requirements")

  responsibilities         String[]  @default([])
  benefits                 String[]  @default([])
  perks                    String[]  @default([])
  additionalInfo           String?   @map("additional_info")
  applicationInstructions  String?   @map("application_instructions")
  contactEmail             String?   @map("contact_email")

  applicationDeadline      DateTime? @map("application_deadline") @db.Timestamptz(6)
  allowAfterDeadline       Boolean   @default(false) @map("allow_after_deadline")
  requireResume            Boolean   @default(true) @map("require_resume")
  requireCoverLetter       Boolean   @default(false) @map("require_cover_letter")
  maxApplications          Int?      @map("max_applications")
  applicationQuestions     Json      @default("[]") @map("application_questions")

  status                   JobStatus           @default(DRAFT)
  moderationStatus         JobModerationStatus @default(NOT_REVIEWED) @map("moderation_status")
  moderationFlags          String[]            @default([]) @map("moderation_flags")
  moderationScore          Int                 @default(0) @map("moderation_score")
  moderationReason         String?             @map("moderation_reason")
  moderatedAt              DateTime?           @map("moderated_at") @db.Timestamptz(6)
  moderatedById            String?             @map("moderated_by") @db.Uuid
  reportCount              Int                 @default(0) @map("report_count")
  contentHash              String?             @map("content_hash")
  requireAdminApproval     Boolean             @default(false) @map("require_admin_approval")
  rejectionReason          String?             @map("rejection_reason")
  submittedAt              DateTime?           @map("submitted_at") @db.Timestamptz(6)
  publishedAt              DateTime?           @map("published_at") @db.Timestamptz(6)
  pausedAt                 DateTime?           @map("paused_at") @db.Timestamptz(6)
  closedAt                 DateTime?           @map("closed_at") @db.Timestamptz(6)
  archivedAt               DateTime?           @map("archived_at") @db.Timestamptz(6)
  createdAt                DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy       User               @relation("JobCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy       User?              @relation("JobUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  approvedBy      User?              @relation("JobApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  moderatedBy     User?              @relation("JobModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  applications    Application[]
  interviews      Interview[]
  hiringDecisions HiringDecision[]
  moderationLogs  JobModerationLog[]
  reports         JobReport[]

  @@index([companyId], map: "idx_jobs_company_id")
  @@index([createdById], map: "idx_jobs_created_by")
  @@index([status], map: "idx_jobs_status")
  @@index([moderationStatus], map: "idx_jobs_moderation_status")
  @@index([companyId, contentHash], map: "idx_jobs_company_content_hash")
  @@index([reportCount], map: "idx_jobs_report_count")
  @@index([employmentType], map: "idx_jobs_employment_type")
  @@index([workMode], map: "idx_jobs_work_mode")
  @@index([publishedAt], map: "idx_jobs_published_at")
  @@map("jobs")
}

model Application {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId                 String            @map("job_id") @db.Uuid
  candidateId           String            @map("candidate_id") @db.Uuid
  companyId             String            @map("company_id") @db.Uuid
  reviewedById          String?           @map("reviewed_by") @db.Uuid
  resumeId              String?           @map("resume_id") @db.Uuid

  resumeKey             String?           @map("resume_key")
  resumeFileName        String?           @map("resume_file_name")
  resumeMimeType        String?           @map("resume_mime_type")
  resumeFileSize        Int?              @map("resume_file_size")

  coverLetter           String?           @map("cover_letter")
  answers               Json              @default("[]")
  additionalInformation String?           @map("additional_information")

  candidateSkills       String[]          @default([]) @map("candidate_skills")
  candidateExperience   Decimal?          @map("candidate_experience") @db.Decimal(4, 1)
  candidateSnapshot     Json              @default("{}") @map("candidate_snapshot")
  jobSnapshot           Json              @default("{}") @map("job_snapshot")

  status                ApplicationStatus @default(SUBMITTED)
  appliedAt             DateTime          @default(now()) @map("applied_at") @db.Timestamptz(6)
  lastStatusUpdatedAt   DateTime          @default(now()) @map("last_status_updated_at") @db.Timestamptz(6)
  withdrawnAt           DateTime?         @map("withdrawn_at") @db.Timestamptz(6)
  withdrawalReason      String?           @map("withdrawal_reason")
  rejectionReason       String?           @map("rejection_reason")
  recruiterNotes        Json              @default("[]") @map("recruiter_notes")

  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  job             Job                        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate       User                       @relation("CandidateApplications", fields: [candidateId], references: [id], onDelete: Cascade)
  company         Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reviewedBy      User?                      @relation("RecruiterReviewedApplications", fields: [reviewedById], references: [id], onDelete: SetNull)
  resume          CandidateResume?           @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  statusHistory   ApplicationStatusHistory[]
  interviews      Interview[]
  feedbacks       InterviewFeedback[]
  hiringDecisions HiringDecision[]

  @@unique([jobId, candidateId], map: "uq_applications_job_candidate")
  @@index([candidateId], map: "idx_applications_candidate_id")
  @@index([jobId], map: "idx_applications_job_id")
  @@index([companyId], map: "idx_applications_company_id")
  @@index([status], map: "idx_applications_status")
  @@index([appliedAt], map: "idx_applications_applied_at")
  @@map("applications")
}

model ApplicationStatusHistory {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId  String             @map("application_id") @db.Uuid
  previousStatus ApplicationStatus? @map("previous_status")
  newStatus      ApplicationStatus  @map("new_status")
  changedById    String?            @map("changed_by") @db.Uuid
