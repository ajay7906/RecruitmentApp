NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/recruit_db

JWT_ACCESS_SECRET=change_me_to_a_long_random_string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Leave SMTP_HOST empty in dev -> emails are printed to console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Recruit <no-reply@recruit.local>"
