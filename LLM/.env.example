# =============================================================================
# AI Recruitment Engine (LLM Microservice) — Environment Configuration Example
# =============================================================================

APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO

# Shared PostgreSQL Database (uses `public` schema for read & `ai` schema for AI tables)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/recruitro
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Shared Resume Storage Path (optional fallback when binary is not passed inline)
RESUME_STORAGE_ROOT=../backend/storage/resumes

# Redis & Celery Background Processing
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false
CELERY_WORKER_CONCURRENCY=4

# Service-to-Service Authentication (Node.js <-> Python)
INTERNAL_API_SECRET=change_me_to_a_strong_internal_service_secret_min_32_chars

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# Matching, Shortlisting & Ranking Settings
MATCHING_SHORTLIST_SIZE=40
MATCHING_DEFAULT_RESULT_LIMIT=5
SCORING_CONFIG_VERSION=v1

# Gemini Rate Limiting, Retries & Token Budgets
GEMINI_MAX_CONCURRENCY=5
GEMINI_MAX_RETRIES=3
GEMINI_TIMEOUT_SECONDS=30

# Daily and Monthly Token Budgets (per company; 0 = unlimited)
AI_DAILY_BUDGET=500000
AI_MONTHLY_BUDGET=10000000

# Pricing Configuration for Cost Estimation (USD per 1M tokens)
GEMINI_INPUT_PRICE_PER_1M=0.15
GEMINI_OUTPUT_PRICE_PER_1M=0.60
GEMINI_EMBEDDING_PRICE_PER_1M=0.02
